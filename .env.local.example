# Copiá este archivo a  .env.local  y completá con tus datos reales.
# (No subas .env.local a git — ya está en .gitignore.)

# Poné en 1 para que la app use la BASE DE DATOS real (API).
# Si lo dejás vacío/0, la app funciona con datos de prueba en memoria.
NEXT_PUBLIC_USE_API=1

# ---- Sesión (OBLIGATORIO en producción) ----
# Clave secreta para FIRMAR la cookie de sesión. Poné una cadena larga y
# aleatoria (mín. 16 chars; ideal 32+). Generá una con:  openssl rand -base64 32
# En Azure va como App Setting "SESSION_SECRET". Si falta en producción,
# NADIE puede iniciar sesión (se falla cerrado a propósito).
SESSION_SECRET=cambiame-por-una-cadena-larga-y-aleatoria

# ---- SQL Server (Azure) ----
SQL_SERVER=mysqladelante.database.windows.net
SQL_DATABASE=AdelanteSBX
SQL_USER=tu_usuario
SQL_PASSWORD=tu_password
# Alternativa: una sola cadena (si la usás, ignora las 4 de arriba)
# SQL_CONNECTION_STRING=Server=tcp:mysqladelante.database.windows.net,1433;Database=AdelanteSBX;User Id=...;Password=...;Encrypt=true;

# ---- Business Central (para los selectores y empujar documentos) ----
# BC_TENANT_ID=
# BC_CLIENT_ID=
# BC_CLIENT_SECRET=
# BC_ENVIRONMENT=Sandbox
# BC_COMPANY=ADELANTE_DESARROLLOS_NUEVA
#
# Almacén al que caen las líneas cuya solicitud no trae uno. Es una RED DE
# SEGURIDAD, no un default cosmético: sin locationCode, BC crea y lanza el pedido
# igual y el material no entra a ningún lado (el stock nunca sube y nadie se entera).
# Si esto queda vacío, la app FRENA el envío a aprobación de esas órdenes en vez de
# dejarlas pasar — a propósito.
# BC_RECEPCION_LOCATION=ALM-GRAL
#
# Dimensión de Centro de Costo en BC (la que dispara el workflow de aprobación).
# BC_DIMENSION_CC=CC
#
# Almacenes que tienen el CC AMARRADO en BC (dimensión predeterminada con registro de
# valores "Igual código"). Para sus líneas la app manda ESE valor y no el de la obra:
# el de la obra deja crear y lanzar el pedido, y BC lo rechaza recién AL REGISTRAR,
# con Bodega mirando el camión (CP-005293 / F-MUEBLES, 3 sep 2026). Formato
# "ALMACEN=VALOR", o solo "ALMACEN" cuando el valor forzado es el mismo código.
# VACÍO = no se fuerza nada (lo normal). Es un parche para poder registrar cuando en
# BC no se puede tocar la configuración: la línea pierde EN BC el CC de la obra.
# BC_CC_POR_ALMACEN=F-MUEBLES=F-MUEBLES
# Item Charge que se usa para el flete cuando la línea no dice cuál.
# BC_ITEM_CHARGE_FLETE=
# Poné 0 para que la app NO cree el pedido en BC al enviar a aprobación.
# BC_CREAR_AL_ENVIAR=1
#
# ---- Cotejo de líneas contra BC (la "pared") ----
# La app compara las líneas de la orden contra las del pedido en BC y CORTA cuando no
# coinciden. Estos dos interruptores existen para poder destrabar producción desde
# Azure sin esperar un despliegue, si alguno diera un falso positivo. Apagados, el
# cotejo se sigue haciendo, se guarda en la orden y se avisa: solo no corta.
# BC_PARED_APROBACION=1   # 0 = no frenar el envío a aprobación aunque BC quedó distinto
# BC_FRENO_REGISTRO=1     # 0 = no verificar las líneas antes de recibir/facturar en BC
